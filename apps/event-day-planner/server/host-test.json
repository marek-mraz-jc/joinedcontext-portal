{
  "gateway": [
    {
      "path": "/ngsi-ld/v1/entities",
      "query": {
        "id": "urn:ngsi-ld:Event:helsinki:fair,urn:ngsi-ld:Event:helsinki:talk"
      },
      "file": "host-test/fair-and-talk.json"
    },
    {
      "path": "/ngsi-ld/v1/entities",
      "query": {
        "id": "urn:ngsi-ld:Event:helsinki:later"
      },
      "file": "host-test/later.json"
    }
  ],
  "steps": [
    {
      "call": "POST /api/itineraries",
      "body": {
        "day": "2030-02-30",
        "ids": [
          "urn:ngsi-ld:Event:helsinki:fair"
        ],
        "lang": "en"
      },
      "status": 400
    },
    {
      "call": "POST /api/itineraries",
      "body": {
        "day": "2020-01-01",
        "ids": [
          "urn:ngsi-ld:Event:helsinki:fair"
        ],
        "lang": "en"
      },
      "status": 400
    },
    {
      "call": "POST /api/itineraries",
      "body": {
        "day": "2030-10-20",
        "ids": [],
        "lang": "en"
      },
      "status": 400
    },
    {
      "call": "POST /api/itineraries",
      "body": {
        "day": "2030-10-20",
        "ids": [
          "urn:ngsi-ld:Place:x"
        ],
        "lang": "en"
      },
      "status": 400
    },
    {
      "call": "POST /api/itineraries",
      "body": {
        "day": "2030-10-20",
        "ids": [
          "urn:ngsi-ld:Event:a&type=Place"
        ],
        "lang": "en"
      },
      "status": 400
    },
    {
      "call": "POST /api/itineraries",
      "body": {
        "day": "2030-10-20",
        "ids": [
          "urn:ngsi-ld:Event:helsinki:fair"
        ],
        "lang": "de"
      },
      "status": 400
    },
    {
      "call": "POST /api/itineraries",
      "body": {
        "day": "2030-10-20",
        "ids": [
          "urn:ngsi-ld:Event:helsinki:fair"
        ],
        "picks": []
      },
      "status": 400
    },
    {
      "call": "POST /api/itineraries",
      "body": {
        "day": "2030-10-20",
        "ids": [
          "urn:ngsi-ld:Event:helsinki:later"
        ],
        "lang": "en"
      },
      "status": 409
    },
    {
      "call": "POST /api/itineraries",
      "body": {
        "day": "2030-10-20",
        "ids": [
          "urn:ngsi-ld:Event:helsinki:fair",
          "urn:ngsi-ld:Event:helsinki:talk"
        ],
        "lang": "en"
      },
      "status": 201,
      "expect": {
        "/picks": [
          "fair",
          "talk"
        ],
        "/day": "2030-10-20"
      },
      "length": {
        "/items": 2
      },
      "save": {
        "code": "/code"
      }
    },
    {
      "call": "GET /api/itineraries/{code}",
      "status": 200,
      "expect": {
        "/day": "2030-10-20",
        "/lang": "en",
        "/picks": [
          "fair",
          "talk"
        ]
      },
      "length": {
        "/items": 2
      }
    },
    {
      "call": "GET /api/itineraries/{code}/ics",
      "status": 200,
      "download": "/url",
      "downloaded": "SUMMARY:Fair\\, autumn\r\nLOCATION:Messukeskus\r\n"
    },
    {
      "call": "GET /api/itineraries/{code}",
      "as": "second",
      "status": 404
    },
    {
      "call": "GET /api/itineraries/{code}/ics",
      "as": "second",
      "status": 404
    },
    {
      "call": "GET /api/itineraries/ABCDEF123456",
      "status": 404
    },
    {
      "call": "GET /api/itineraries/zzzzzzzzzzzz",
      "status": 404
    }
  ]
}