    "AirQualityObserved": {
      "additionalProperties": false,
      "description": "One air quality station around Helsinki and its newest hourly readings: FMI's stations, and the stations a steward adds by hand, which carry no source.",
      "properties": {
        "airQualityIndex": {
          "description": "FMI's hourly air quality index, 1 (good) to 5 (very poor).",
          "maximum": 5,
          "minimum": 1,
          "type": [
            "number",
            "null"
          ],
          "x-ngsi-ld-kind": "Property"
        },
        "dateObserved": {
          "description": "When the readings were taken.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ],
          "x-ngsi-ld-kind": "Property"
        },
        "id": {
          "description": "The entity id, urn:ngsi-ld:{Type}:{orgDomain}:{space}:{localId}.",
          "type": "string",
          "x-ngsi-ld-kind": "Property"
        },
        "location": {
          "description": "Where the entity is, as GeoJSON geometry.",
          "properties": {
            "coordinates": {
              "type": "array"
            },
            "type": {
              "enum": [
                "Point",
                "MultiPoint",
                "LineString",
                "MultiLineString",
                "Polygon",
                "MultiPolygon"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "coordinates"
          ],
          "type": [
            "object",
            "null"
          ],
          "x-ngsi-ld-kind": "GeoProperty"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The name, per language.",
          "type": [
            "object",
            "null"
          ],
          "x-ngsi-ld-kind": "LanguageProperty"
        },
        "observedAt": {
          "description": "When the observation the entity reports was made.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ],
          "x-ngsi-ld-kind": "Property"
        },
        "pm10": {
          "description": "Particulate matter up to 10 µm, the hour's mean at the station.",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ],
          "x-ngsi-ld-kind": "Property",
          "x-unit": {
            "ucumCode": "ug/m3"
          }
        },
        "pm25": {
          "description": "Particulate matter up to 2.5 µm, the hour's mean at the station.",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ],
          "x-ngsi-ld-kind": "Property",
          "x-unit": {
            "ucumCode": "ug/m3"
          }
        },
        "source": {
          "description": "The open-data service the entity was read from.",
          "format": "uri",
          "type": [
            "string",
            "null"
          ],
          "x-ngsi-ld-kind": "Property"
        },
        "stewardNote": {
          "description": "A note by the person who keeps this data: what was checked, what looks wrong, whom to ask. No pipeline writes it and no pipeline overwrites it, so an application may offer it for editing without the next run taking the words back (AP-62). At most 500 characters and no angle brackets, because it is a note and not a document.",
          "pattern": "^[^<>]{0,500}$",
          "type": [
            "string",
            "null"
          ],
          "x-ngsi-ld-kind": "Property"
        },
        "type": {
          "description": "The entity type, one class of a published data model.",
          "type": "string",
          "x-ngsi-ld-kind": "Property"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "AirQualityObserved",
      "type": "object"
    },
