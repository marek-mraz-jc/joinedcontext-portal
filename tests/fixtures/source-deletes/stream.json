{
  "input": {
    "generate": {
      "count": 1,
      "interval": "",
      "mapping": "root = \"\".decode(\"base64\").parse_json()"
    }
  },
  "output": {
    "http_client": {
      "headers": {
        "Content-Type": "application/json"
      },
      "oauth2": {
        "client_key": "helsinki-pipelines",
        "client_secret": "${JC_CLIENT_SECRET_HELSINKI}",
        "enabled": true,
        "token_url": "${JC_TOKEN_URL}"
      },
      "timeout": "10s",
      "url": "http://127.0.0.1:18089/report",
      "verb": "POST"
    }
  },
  "pipeline": {
    "processors": [
      {
        "unarchive": {
          "format": "json_array"
        }
      },
      {
        "try": [
          {
            "branch": {
              "processors": [
                {
                  "http": {
                    "headers": {
                      "Accept": "application/json",
                      "Content-Type": "application/json",
                      "JC-Reason": "source-snapshot%3A%20pipeline%20registry%20run%202026-10-20T05%3A00%3A00Z"
                    },
                    "oauth2": {
                      "client_key": "helsinki-pipelines",
                      "client_secret": "${JC_CLIENT_SECRET_HELSINKI}",
                      "enabled": true,
                      "token_url": "${JC_TOKEN_URL}"
                    },
                    "retries": 1,
                    "timeout": "30s",
                    "url": "${JC_GATEWAY_URL}/api/endpoint/ep-slug/ngsi-ld/v1/entityOperations/delete",
                    "verb": "POST"
                  }
                }
              ],
              "request_map": "root = this.ids",
              "result_map": "root.answer = if content().length() == 0 { null } else { this }"
            }
          },
          {
            "mapping": "let errors = this.answer.errors.or([])\nroot.run = this.run\nroot.deleted = if this.answer == null { this.ids } else { this.answer.success.or([]) }\nroot.gone = $errors.filter(e -> e.error.status.or(0) == 404 || e.error.type.or(\"\").string().has_suffix(\"ResourceNotFound\")).map_each(e -> e.entityId)\nroot.failed = $errors.filter(e -> !(e.error.status.or(0) == 404 || e.error.type.or(\"\").string().has_suffix(\"ResourceNotFound\"))).map_each(e -> {\"id\": e.entityId, \"message\": e.error.title.or(e.error.detail).or(\"refused\").string()})"
          }
        ]
      },
      {
        "catch": [
          {
            "mapping": "root = {\"run\": this.run, \"deleted\": [], \"gone\": [], \"failed\": this.ids.map_each(id -> {\"id\": id, \"message\": error().or(\"the gateway did not answer\")})}"
          }
        ]
      }
    ]
  }
}
