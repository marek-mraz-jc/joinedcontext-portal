// manifest-write-without-rbac: a route handler (a function a router names, routers excluded) that reaches the manifest write (GiteaClient::put_file) and no permission check (T-3681, PF-50)
MATCH (r:Symbol)-[:CALLS]->(x:Symbol) WHERE x.external AND x.path STARTS WITH 'axum::routing::' AND NOT r.is_test WITH DISTINCT r MATCH (r)-[:CALLS]->(h:Symbol) WHERE NOT h.external AND NOT h.is_test AND NOT EXISTS { MATCH (h)-[:CALLS]->(y:Symbol) WHERE y.external AND y.path STARTS WITH 'axum::routing::' } AND EXISTS { MATCH (h)-[:CALLS|DISPATCHES*1..6]->(w:Symbol {path:'joinedcontext_portal::git::gitea::GiteaClient::put_file'}) } AND NOT EXISTS { MATCH (h)-[:CALLS|DISPATCHES*1..6]->(g:Symbol) WHERE g.path STARTS WITH 'joinedcontext_portal::permissions::' } RETURN DISTINCT h.path ORDER BY h.path;
// token-request-outside-owners: a request to the OIDC token endpoint (every grant names grant_type) outside src/auth, which owns login and the Portal's client credential; each other caller is allowlisted with what its token is for. A Keycloak admin client fetches its own admin token, so a new admin call site is a row here too (T-3681)
GREP "grant_type" IN src/**/*.rs;
// handler-without-decision: a route handler that takes a signed-in CurrentUser and reaches no permission decision (crate::permissions) within 6 hops; each row is a route whose data is the caller's own or the instance's (T-3846, PF-50)
MATCH (r:Symbol)-[:CALLS]->(x:Symbol) WHERE x.external AND x.path STARTS WITH 'axum::routing::' AND NOT r.is_test WITH DISTINCT r MATCH (r)-[:CALLS]->(h:Symbol) WHERE NOT h.external AND NOT h.is_test AND h.package = 'joinedcontext-portal' AND h.signature CONTAINS 'CurrentUser' AND NOT EXISTS { MATCH (h)-[:CALLS]->(y:Symbol) WHERE y.external AND y.path STARTS WITH 'axum::routing::' } AND NOT EXISTS { MATCH (h)-[:CALLS|DISPATCHES*1..6]->(g:Symbol) WHERE g.path STARTS WITH 'joinedcontext_portal::permissions::' } RETURN DISTINCT h.path ORDER BY h.path;
// handler-without-identity: a route handler or middleware with no CurrentUser that reaches none of the Portal's other doors: a permission decision, the internal listener's bearer (auth::internal), an App's service gate or person (apps::services::gate, apps::roles::person), or the MCP bearer (auth::bearer); each row is public on purpose and says why (T-3846)
MATCH (r:Symbol)-[:CALLS]->(x:Symbol) WHERE x.external AND (x.path STARTS WITH 'axum::routing::' OR x.path STARTS WITH 'axum::middleware::') AND NOT r.is_test AND r.package = 'joinedcontext-portal' WITH DISTINCT r MATCH (r)-[:CALLS]->(h:Symbol) WHERE NOT h.external AND NOT h.is_test AND h.is_async AND h.package = 'joinedcontext-portal' AND NOT h.signature CONTAINS 'CurrentUser' AND NOT EXISTS { MATCH (h)-[:CALLS]->(y:Symbol) WHERE y.external AND y.path STARTS WITH 'axum::routing::' } AND NOT EXISTS { MATCH (h)-[:CALLS|DISPATCHES*1..6]->(g:Symbol) WHERE g.path STARTS WITH 'joinedcontext_portal::permissions::' OR g.path STARTS WITH 'joinedcontext_portal::auth::internal::' OR g.path STARTS WITH 'joinedcontext_portal::auth::bearer::' OR g.path IN ['joinedcontext_portal::apps::services::gate', 'joinedcontext_portal::apps::roles::person'] } RETURN DISTINCT h.path ORDER BY h.path;
// internal-handler-without-bearer: a handler of the internal listener (api::internal) that does not authenticate its caller through auth::internal; must stay empty: that port has no session and no CSRF layer (AG-52, T-3846)
MATCH (r:Symbol)-[:CALLS]->(x:Symbol) WHERE x.external AND x.path STARTS WITH 'axum::routing::' AND NOT r.is_test WITH DISTINCT r MATCH (r)-[:CALLS]->(h:Symbol) WHERE NOT h.external AND NOT h.is_test AND h.path STARTS WITH 'joinedcontext_portal::api::internal::' AND NOT EXISTS { MATCH (h)-[:CALLS]->(y:Symbol) WHERE y.external AND y.path STARTS WITH 'axum::routing::' } AND NOT EXISTS { MATCH (h)-[:CALLS|DISPATCHES*1..4]->(g:Symbol) WHERE g.path STARTS WITH 'joinedcontext_portal::auth::internal::' } RETURN DISTINCT h.path ORDER BY h.path;
// outbound-http: a file whose non-test code sends an HTTP request (reqwest); a new file is a new place the Portal fetches from, and a URL a person or a manifest names needs the sync::guard address rule (T-3846, T-1705)
MATCH (c:Symbol)-[:CALLS]->(f:Symbol) WHERE f.external AND f.path =~ 'reqwest::.*Client::(get|post|put|delete|patch|request|head)' AND NOT c.is_test AND c.package = 'joinedcontext-portal' RETURN DISTINCT c.file ORDER BY c.file;
// dynamic-sql: a query string that is not a literal (sqlx AssertSqlSafe); each one binds every value and builds only its shape from fixed text (T-3846)
GREP AssertSqlSafe\( IN src/**/*.rs;
// fs-write: a write, rename or removal on the local filesystem; each names where its path comes from (T-3846)
GREP (fs::write|fs::remove_file|fs::remove_dir_all|fs::rename|fs::create_dir_all|File::create|OpenOptions::new) IN src/**/*.rs;
// ui-call-to-missing-route: a UI or App SDK call (.cg/links) to a route no handler provides; each row is a broken button (T-3916)
MATCH (u)-[:USES]->(c:Channel {channel:'http'}) WHERE c.providers = 0 RETURN DISTINCT c.key, u.path ORDER BY c.key;
// route-without-caller: a route no UI page or App SDK call reaches; each row names its outside caller (a client of the documented API, a workload, a probe, a redirect), or is dead code to delete (T-3916)
MATCH (h:Symbol)-[:PROVIDES]->(c:Channel {channel:'http'}) WHERE c.users = 0 RETURN DISTINCT c.key, h.path ORDER BY c.key;
// button-to-decision: a route a UI page or App SDK call reaches whose handler reaches no decision of crate::permissions and none of the other doors (the internal bearer, the MCP bearer, an App's service gate or person) within 8 hops; each row says why the session alone is enough (T-3916)
MATCH (u:Symbol)-[:USES]->(c:Channel {channel:'http'})<-[:PROVIDES]-(h:Symbol) WHERE NOT EXISTS { MATCH (h)-[:CALLS|DISPATCHES*1..8]->(g:Symbol) WHERE g.path STARTS WITH 'joinedcontext_portal::permissions::' OR g.path STARTS WITH 'joinedcontext_portal::auth::internal::' OR g.path STARTS WITH 'joinedcontext_portal::auth::bearer::' OR g.path IN ['joinedcontext_portal::apps::services::gate', 'joinedcontext_portal::apps::roles::person'] } RETURN DISTINCT c.key, h.path ORDER BY c.key;
