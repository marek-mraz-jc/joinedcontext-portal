+// dev/cg-invariants/fixture.patch: a UI call to a route nobody serves, and a button to a route that
+// decides nothing.
+import { api } from "./api/client";
+
+export async function cgFixtureMissing(): Promise<unknown> {
+  return api.GET("/api/v1/cg-fixture/missing" as never);
+}
+
+export async function cgFixtureMine(): Promise<unknown> {
+  return api.GET("/api/v1/cg-fixture/mine" as never);
+}
