+//! dev/cg-invariants/fixture.patch: one violation per statement of dev/security.cypher.
+
+use axum::extract::State;
+use axum::routing::post;
+use axum::Router;
+
+use crate::git::gitea::{Author, FileWrite};
+use crate::state::AppState;
+
+/// Routes the handler below, so the graph sees it as a route handler.
+pub fn router() -> Router<AppState> {
+    Router::new().route("/cg-fixture", post(cg_fixture_write))
+}
+
+/// A manifest write no permission check guards.
+async fn cg_fixture_write(State(state): State<AppState>) -> &'static str {
+    if let Some(gitea) = state.forge_for("fixture") {
+        let _ = gitea
+            .put_file(&FileWrite {
+                path: "x.yaml",
+                branch: "main",
+                message: "fixture",
+                content: "",
+                sha: None,
+                author: Author {
+                    name: "fixture",
+                    email: "fixture@example.org",
+                },
+            })
+            .await;
+    }
+    "written"
+}
+
+/// A token request outside src/auth.
+pub async fn cg_fixture_token(url: &str) -> reqwest::Result<reqwest::Response> {
+    reqwest::Client::new()
+        .post(url)
+        .form(&[("grant_type", "client_credentials")])
+        .send()
+        .await
+}
+
+/// A signed-in route that reaches no permission decision.
+pub fn decision_router() -> Router<AppState> {
+    Router::new().route("/cg-fixture/mine", axum::routing::get(cg_fixture_mine))
+}
+
+async fn cg_fixture_mine(_user: crate::auth::CurrentUser) -> &'static str {
+    "anyone signed in"
+}
+
+/// A query string that is not a literal.
+pub fn cg_fixture_sql(text: String) -> sqlx::AssertSqlSafe<String> {
+    sqlx::AssertSqlSafe(text)
+}
+
+/// A write on the local filesystem.
+pub fn cg_fixture_fs(path: &std::path::Path) -> std::io::Result<()> {
+    std::fs::write(path, b"fixture")
+}
