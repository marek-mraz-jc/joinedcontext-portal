{
  "name": "jc-react-rust-wasm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "wasm": "cd wasm && cargo build --release --target wasm32-unknown-unknown --locked && wasm-bindgen --target web --out-dir pkg target/wasm32-unknown-unknown/release/jc_wasm_example.wasm",
    "build": "tsc -b && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@joinedcontext/sdk": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
