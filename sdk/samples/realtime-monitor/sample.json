  "ready": "Air quality now",
  "dataNeeds": [
    {
      "types": ["AirQualityObserved"],
      "attrs": ["stationName", "pm25", "no2", "dateObserved"],
      "operations": ["queryEntity", "queryTemporal"]
    }
  ],
  "access": "Read-only: the current readings and their last hour.",
  "sdk": ["useEntities (refreshMs)", "useClient().temporal.list", "format", "Page", "Header", "Split", "Grid", "Card"]
